# Copy this to .env and fill in real values.
# Never commit .env to version control.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=puzzlink_ph
DB_USER=puzzlink_user
DB_PASS=STRONG_PASSWORD_HERE

JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_STRING

OW_SECRET_TAPJOY=
OW_SECRET_ADJOE=
OW_SECRET_IRONSRC=
OW_SECRET_CPX=
OW_SECRET_WANNADS=

# AppLovin MAX SSV (Server-Side Verification for rewarded ads)
APPLOVIN_SSV_KEY=

# Xendit (GCash / Maya disbursements)
# Get from: https://dashboard.xendit.co/settings/developers
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
